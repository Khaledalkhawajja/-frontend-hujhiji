# Copy to .env.local and change if needed. Never commit real secrets (this file has none).

# Base URL of the backend API.
# Default: talk to the API directly (cookies work because both run on "localhost").
VITE_API_URL=http://localhost:4000/api/v1

# Alternative if cookies give you trouble in development: go through the dev-server proxy (same origin).
# VITE_API_URL=/api/v1
# VITE_API_PROXY_TARGET=http://localhost:4000
